rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // All sample and LIMS collections: user can only read/write their own docs
    // Legacy docs (no uid field) are accessible to the creator only via fallback
    function isOwner(data) {
      return !('uid' in data) || data.uid == request.auth.uid;
    }

    match /bmp_samples/{doc} {
      allow read, write: if request.auth != null && isOwner(resource.data);
      allow create: if request.auth != null;
    }
    match /water_quality/{doc} {
      allow read, write: if request.auth != null && isOwner(resource.data);
      allow create: if request.auth != null;
    }
    match /wastewater/{doc} {
      allow read, write: if request.auth != null && isOwner(resource.data);
      allow create: if request.auth != null;
    }
    match /soil_samples/{doc} {
      allow read, write: if request.auth != null && isOwner(resource.data);
      allow create: if request.auth != null;
    }
    match /inoculum_batches/{doc} {
      allow read, write: if request.auth != null && isOwner(resource.data);
      allow create: if request.auth != null;
    }
    match /characterization/{doc} {
      allow read, write: if request.auth != null && isOwner(resource.data);
      allow create: if request.auth != null;
    }
    match /bmp_experiments/{doc} {
      allow read, write: if request.auth != null && isOwner(resource.data);
      allow create: if request.auth != null;
    }
    match /gas_measurements/{doc} {
      allow read, write: if request.auth != null && isOwner(resource.data);
      allow create: if request.auth != null;
    }
  }
}
